NEXT_PUBLIC_SUPABASE_URL=https://slscoqdhbxftcournvut.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
# Required server-side for partner-owner invitations and published microsite reads.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_PARTNER_MEDIA_BUCKET=partner-assets
NEXT_PUBLIC_BENEFITSI_APP_URL=
NEXT_PUBLIC_BENEFITSI_CITY_BASE_URL=https://benefitsi.de
NEXT_PUBLIC_BENEFITSI_WEB_URL=https://benefitsi.de
# Server-only: use matching, separate values for staging and production.
BENEFITSI_WEB_REVALIDATION_URL=https://benefitsi.de/api/revalidate
# At least 32 random characters; leave unset until provisioned.
BENEFITSI_WEB_REVALIDATION_SECRET=
# Optional server-only Vercel automation bypass; scope to the paired Preview branch.
# Sent only in VERCEL_ENV=preview and only to a configured *.vercel.app origin.
BENEFITSI_WEB_PROTECTION_BYPASS_SECRET=
# Optional for self-hosting; use one value for every server in a deployment.
NEXT_DEPLOYMENT_ID=
# Required for self-hosted multi-instance deployments; generate a base64 AES key.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Stripe stays in test mode until production checkout is explicitly approved.
STRIPE_SECRET_KEY=sk_test_replace-with-test-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-test-webhook-secret
# Optional: retain the old "Your account" endpoint for historical destination payments.
# New merchant events use the Connected accounts endpoint above; billing stays separate.
STRIPE_LEGACY_WEBHOOK_SECRET=
BENEFITSI_BOOKING_BASE_URL=http://localhost:3011
BENEFITSI_BOOKING_PROXY_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters

# Hermes/M1 city-agent bridge (server-only; use an HTTPS endpoint or local tunnel)
M1_BRIDGE_URL=
M1_BRIDGE_SECRET=
CITY_AGENT_HERMES_PROFILE=city-annweiler
CITY_AGENT_HERMES_REQUIRED=false
BENEFITSI_APPROVED_CITY_SOURCE_DOMAINS=annweiler.de,vg-annweiler.de,suedlicheweinstrasse.de,trifelsland.de,gdke.rlp.de
# Keep false until the Ben profile and city allowlist are configured on M1.
CITY_AGENT_AUTO_PUBLISH=false
# Server-only key used by the partner research assistant.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional; defaults to Gemini 3.5 Flash and falls back to current Flash aliases.
GEMINI_PARTNER_ENRICHMENT_MODEL=gemini-3.5-flash
# Photo/PDF menu import uses M1_BRIDGE_URL and M1_BRIDGE_SECRET above.
# Dedicated Hermes profile on M1: benefitsi-menu; no Gemini key is used for menu import.

# Server-only cache invalidation; same secret in the public website project.
BENEFITSI_ADMIN_REVALIDATION_SECRET=
BENEFITSI_WEB_URL=https://benefitsi.de

# Optional server-only Google SEO measurements. No jobs run on setup save.
# Authorize only https://www.googleapis.com/auth/webmasters.readonly.
SEO_GOOGLE_CLIENT_ID=
SEO_GOOGLE_CLIENT_SECRET=
SEO_GOOGLE_REFRESH_TOKEN=
SEO_GSC_PROPERTY=
SEO_PAGESPEED_API_KEY=
# Automated collection uses encrypted OAuth connections in private storage.
# Generate a 32-byte base64 key once; preserve it across deployments.
SEO_TOKEN_ENCRYPTION_KEY=
# Optional confirmed free-only SERP account. Shared DB allowance defaults to 0.
SEO_BRIGHTDATA_API_KEY=
SEO_BRIGHTDATA_ZONE=

# Prepared booking modules. Keep disabled until local/staging acceptance is complete.
BENEFITSI_COMMERCE_ENABLED=false
BENEFITSI_BOOKING_WEB_ORIGIN=http://localhost:3025
BENEFITSI_STRIPE_CONNECT_PLATFORM_READY=false
# Existing TEST price: active, EUR, recurring monthly, licensed. Never a customer payment.
BENEFITSI_SOFTWARE_PRICE_ID=
BENEFITSI_SOFTWARE_PORTAL_CONFIGURATION_ID=
# Separate platform subscription webhook (the earlier secret is for connected merchants).
STRIPE_BILLING_WEBHOOK_SECRET=
# Transactional booking mail. No delivery/claim occurs without a complete provider.
BENEFITSI_NOTIFICATION_WORKER_SECRET=
# Recommended explicit selection: resend. Sender domain must be verified in Resend.
BENEFITSI_NOTIFICATION_PROVIDER=
RESEND_API_KEY=
BENEFITSI_BOOKING_FROM_EMAIL=
# Optional alternative: adapter. Trusted HTTPS processor owns audience-safe deduplication.
BENEFITSI_NOTIFICATION_DELIVERY_URL=
BENEFITSI_NOTIFICATION_DELIVERY_TOKEN=
