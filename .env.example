NEXT_PUBLIC_SUPABASE_URL=https://slscoqdhbxftcournvut.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
# Required server-side for partner-owner invitations and published microsite reads.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_PARTNER_MEDIA_BUCKET=partner-assets
NEXT_PUBLIC_BENEFITSI_APP_URL=
NEXT_PUBLIC_BENEFITSI_CITY_BASE_URL=https://benefitsi.de
NEXT_PUBLIC_BENEFITSI_WEB_URL=https://benefitsi.de
# Optional for self-hosting; use one value for every server in a deployment.
NEXT_DEPLOYMENT_ID=
# Required for self-hosted multi-instance deployments; generate a base64 AES key.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Stripe stays in test mode until production checkout is explicitly approved.
STRIPE_SECRET_KEY=sk_test_replace-with-test-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-test-webhook-secret
BENEFITSI_BOOKING_BASE_URL=http://localhost:3011
BENEFITSI_BOOKING_PROXY_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters

# Hermes/M1 city-agent bridge (server-only; use an HTTPS endpoint or local tunnel)
M1_BRIDGE_URL=
M1_BRIDGE_SECRET=
CITY_AGENT_HERMES_PROFILE=city-annweiler
CITY_AGENT_HERMES_REQUIRED=false
BENEFITSI_APPROVED_CITY_SOURCE_DOMAINS=annweiler.de,vg-annweiler.de,suedlicheweinstrasse.de,trifelsland.de,gdke.rlp.de
# Keep false until the Ben profile and city allowlist are configured on M1.
CITY_AGENT_AUTO_PUBLISH=false
# Server-only key used by the partner research assistant.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional; defaults to Gemini 3.5 Flash and falls back to current Flash aliases.
GEMINI_PARTNER_ENRICHMENT_MODEL=gemini-3.5-flash
